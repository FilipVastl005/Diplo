<!DOCTYPE html>
<html lang="cs">
<head><%- include('../partials/layout-head', { pageTitle: 'Administrace' }) %></head>
<body>
<div class="app-wrapper">
  <%- include('../partials/sidebar') %>
  <div class="main-content">
    <%- include('../partials/topbar') %>
    <div class="content-area">

      <div class="page-header">
        <h1 class="page-title">Administrace</h1>
      </div>

      <!-- Stats -->
      <div class="admin-stats">
        <div class="stat-card">
          <div class="stat-value"><%= stats.students %></div>
          <div class="stat-label">Studenti</div>
        </div>
        <div class="stat-card">
          <div class="stat-value"><%= stats.teachers %></div>
          <div class="stat-label">Ucitele</div>
        </div>
        <div class="stat-card">
          <div class="stat-value"><%= stats.subjects %></div>
          <div class="stat-label">Predmety</div>
        </div>
        <div class="stat-card">
          <div class="stat-value"><%= stats.grades %></div>
          <div class="stat-label">Znamky</div>
        </div>
      </div>

      <!-- Quick links -->
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:24px">
        <a href="/admin/users" class="card" style="text-decoration:none;text-align:center;padding:20px;transition:box-shadow .15s" onmouseover="this.style.boxShadow='0 4px 20px rgba(109,40,217,.2)'" onmouseout="this.style.boxShadow=''">
          <div style="font-size:28px;margin-bottom:8px">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--purple-500)" stroke-width="2" width="32" height="32"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div style="font-size:15px;font-weight:700;color:var(--text-primary)">Uzivatele</div>
          <div style="font-size:12px;color:var(--text-muted)"><%= stats.users %> celkem</div>
        </a>
        <a href="/admin/subjects" class="card" style="text-decoration:none;text-align:center;padding:20px;transition:box-shadow .15s" onmouseover="this.style.boxShadow='0 4px 20px rgba(109,40,217,.2)'" onmouseout="this.style.boxShadow=''">
          <div style="margin-bottom:8px">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--purple-500)" stroke-width="2" width="32" height="32"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <div style="font-size:15px;font-weight:700;color:var(--text-primary)">Predmety</div>
          <div style="font-size:12px;color:var(--text-muted)"><%= stats.subjects %> predmetu</div>
        </a>
        <a href="/admin/rozvrh" class="card" style="text-decoration:none;text-align:center;padding:20px;transition:box-shadow .15s" onmouseover="this.style.boxShadow='0 4px 20px rgba(109,40,217,.2)'" onmouseout="this.style.boxShadow=''">
          <div style="margin-bottom:8px">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--purple-500)" stroke-width="2" width="32" height="32"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div style="font-size:15px;font-weight:700;color:var(--text-primary)">Rozvrh</div>
          <div style="font-size:12px;color:var(--text-muted)">Spravovat rozvrh</div>
        </a>
      </div>

      <!-- Recent grades -->
      <div class="card">
        <h2 class="card-title">Posledni znamky</h2>
        <table class="table">
          <thead>
            <tr><th>Datum</th><th>Student</th><th>Predmet</th><th>Znamka</th><th>Ucitel</th></tr>
          </thead>
          <tbody>
            <% recentGrades.forEach(function(g) { %>
              <tr>
                <td><%= new Date(g.date + 'T00:00:00').toLocaleDateString('cs-CZ') %></td>
                <td><%= g.student_name %></td>
                <td><%= g.subject_short %></td>
                <td><span class="grade-badge grade-<%= g.grade %>"><%= g.grade %></span></td>
                <td><%= g.teacher_name || '-' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

    </div>
  </div>
</div>
</body>
</html>
