<!DOCTYPE html>
<html lang="cs">
<head><%- include('../partials/layout-head', { pageTitle: 'Sprava uzivatelu' }) %></head>
<body>
<div class="app-wrapper">
  <%- include('../partials/sidebar') %>
  <div class="main-content">
    <%- include('../partials/topbar') %>
    <div class="content-area">

      <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

      <div style="display:grid;grid-template-columns:1fr 340px;gap:20px;align-items:start">

        <div>
          <div class="page-header">
            <h1 class="page-title">Uzivatele</h1>
            <div style="display:flex;gap:8px">
              <a href="/admin/users" class="btn <%= !roleFilter ? 'btn-primary' : 'btn-secondary' %> btn-sm">Vsichni</a>
              <a href="/admin/users?role=student" class="btn <%= roleFilter==='student' ? 'btn-primary' : 'btn-secondary' %> btn-sm">Studenti</a>
              <a href="/admin/users?role=teacher" class="btn <%= roleFilter==='teacher' ? 'btn-primary' : 'btn-secondary' %> btn-sm">Ucitele</a>
              <a href="/admin/users?role=admin" class="btn <%= roleFilter==='admin' ? 'btn-primary' : 'btn-secondary' %> btn-sm">Admini</a>
            </div>
          </div>
          <div class="card">
            <table class="table">
              <thead>
                <tr><th>Jmeno</th><th>Uzivatelske jmeno</th><th>Role</th><th>Trida</th><th>Email</th><th>Akce</th></tr>
              </thead>
              <tbody>
                <% users.forEach(function(u) { %>
                  <tr>
                    <td>
                      <div style="display:flex;align-items:center;gap:8px">
                        <div class="user-avatar" style="background:<%= u.avatar_color %>;width:28px;height:28px;font-size:11px">
                          <%= u.first_name.charAt(0) %><%= u.last_name.charAt(0) %>
                        </div>
                        <%= u.first_name %> <%= u.last_name %>
                      </div>
                    </td>
                    <td><code><%= u.username %></code></td>
                    <td><span class="badge badge-<%= u.role %>"><%= u.role === 'admin' ? 'Admin' : u.role === 'teacher' ? 'Ucitel' : 'Student' %></span></td>
                    <td><%= u.class_name || '-' %></td>
                    <td><%= u.email || '-' %></td>
                    <td>
                      <div class="action-row">
                        <button class="btn btn-secondary btn-sm" onclick="openEditModal(<%= JSON.stringify({id:u.id,first_name:u.first_name,last_name:u.last_name,email:u.email||'',role:u.role,class_name:u.class_name||'',avatar_color:u.avatar_color}) %>)">Upravit</button>
                        <% if (u.id !== user.id) { %>
                          <form method="POST" action="/admin/users/<%= u.id %>/delete" onsubmit="return confirm('Smazat uzivatele <%= u.first_name %> <%= u.last_name %>?')">
                            <button type="submit" class="btn btn-danger btn-sm">Smazat</button>
                          </form>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Create user form -->
        <div class="card" style="position:sticky;top:24px">
          <h2 class="card-title" style="font-size:17px;margin-bottom:14px">Novy uzivatel</h2>
          <form method="POST" action="/admin/users/create">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
              <div class="form-group">
                <label class="form-label">Jmeno</label>
                <input class="form-control" type="text" name="first_name" required maxlength="50">
              </div>
              <div class="form-group">
                <label class="form-label">Prijmeni</label>
                <input class="form-control" type="text" name="last_name" required maxlength="50">
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Uzivatelske jmeno</label>
              <input class="form-control" type="text" name="username" required maxlength="64" placeholder="napr. jan.novak">
            </div>
            <div class="form-group">
              <label class="form-label">Heslo</label>
              <input class="form-control" type="password" name="password" required minlength="6" maxlength="128">
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
              <div class="form-group">
                <label class="form-label">Role</label>
                <select class="form-control" name="role" required>
                  <option value="student">Student</option>
                  <option value="teacher">Ucitel</option>
                  <option value="admin">Admin</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label">Trida</label>
                <input class="form-control" type="text" name="class_name" maxlength="10" placeholder="napr. 3A">
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Email</label>
              <input class="form-control" type="email" name="email" maxlength="100">
            </div>
            <div class="form-group">
              <label class="form-label">Barva avataru</label>
              <input class="form-control" type="color" name="avatar_color" value="#7c3aed" style="height:40px;padding:4px">
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center">Vytvorit uzivatele</button>
          </form>
        </div>
      </div>

      <!-- Edit modal -->
      <div id="editModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:999;align-items:center;justify-content:center">
        <div class="card" style="width:480px;max-height:90vh;overflow-y:auto;position:relative">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
            <h2 style="font-size:18px;font-weight:700">Upravit uzivatele</h2>
            <button onclick="closeEditModal()" style="background:none;border:none;font-size:20px;cursor:pointer;color:var(--text-muted)">&times;</button>
          </div>
          <form method="POST" id="editForm">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
              <div class="form-group"><label class="form-label">Jmeno</label><input class="form-control" type="text" name="first_name" id="ef_first_name" required maxlength="50"></div>
              <div class="form-group"><label class="form-label">Prijmeni</label><input class="form-control" type="text" name="last_name" id="ef_last_name" required maxlength="50"></div>
            </div>
            <div class="form-group"><label class="form-label">Email</label><input class="form-control" type="email" name="email" id="ef_email" maxlength="100"></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
              <div class="form-group"><label class="form-label">Role</label><select class="form-control" name="role" id="ef_role"><option value="student">Student</option><option value="teacher">Ucitel</option><option value="admin">Admin</option></select></div>
              <div class="form-group"><label class="form-label">Trida</label><input class="form-control" type="text" name="class_name" id="ef_class_name" maxlength="10"></div>
            </div>
            <div class="form-group"><label class="form-label">Barva avataru</label><input class="form-control" type="color" name="avatar_color" id="ef_avatar_color" style="height:40px;padding:4px"></div>
            <div class="form-group"><label class="form-label">Nove heslo (nechat prazdne pro nezmeneni)</label><input class="form-control" type="password" name="password" minlength="6" maxlength="128"></div>
            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center">Ulozit zmeny</button>
          </form>
        </div>
      </div>

    </div>
  </div>
</div>
<script>
function openEditModal(u) {
  document.getElementById('ef_first_name').value = u.first_name;
  document.getElementById('ef_last_name').value = u.last_name;
  document.getElementById('ef_email').value = u.email;
  document.getElementById('ef_role').value = u.role;
  document.getElementById('ef_class_name').value = u.class_name;
  document.getElementById('ef_avatar_color').value = u.avatar_color;
  document.getElementById('editForm').action = '/admin/users/' + u.id + '/edit';
  document.getElementById('editModal').style.display = 'flex';
}
function closeEditModal() {
  document.getElementById('editModal').style.display = 'none';
}
document.getElementById('editModal').addEventListener('click', function(e) {
  if (e.target === this) closeEditModal();
});
</script>
</body>
</html>
